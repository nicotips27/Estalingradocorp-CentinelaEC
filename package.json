{
  "name": "metatron",
  "version": "1.0.0",
  "description": "METATRON - App de escritorio",
  "main": "main.js",
  "author": "METATRON",
  "license": "MIT",
  "allowScripts": {
    "electron": "postinstall"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.metatron.beta",
    "productName": "METATRON",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.html",
      "splash.html",
      "home.html",
      "notes.html",
      "notes-preload.js",
      "history.html",
      "history-preload.js",
      "settings.html",
      "settings-preload.js",
      "logo.jpg",
      "icon.png",
      "img-ecnews.jpg",
      "img-palantir.png",
      "img-ecsendpro.png",
      "img-warwatch.png",
      "img-conflictradar.png",
      "img-worldmonitor.png",
      "img-radiogarden.png",
      "img-famelack.png",
      "img-osiris.png",
      "img-opengrid.webp",
      "img-driveandlisten.png",
      "adblock.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "METATRON",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0"
  }
}
